AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
PROCESSING_JOBS_TABLE_NAME=fiapx-dev-videos-db
SQS_QUEUE_NAMES_VIDEO_PROCESSING_REQUESTED=fiapx-dev-video-processing-requested
SQS_QUEUE_NAMES_VIDEO_PROCESSING_COMPLETED=fiapx-dev-video-processing-completed
S3_BUCKET_PREFIX=fiapx-dev-artifacts
FRAME_PREFIX=frames
FFMPEG_PATH=ffmpeg

# Observability. APP_ENV feeds deployment.environment: development | staging | production.
APP_ENV=development
APP_NAME=processor
APP_VERSION=1.0.0
DD_OTLP_ENDPOINT=https://otlp.us5.datadoghq.com
# Leave empty locally: with no key the service starts with observability disabled.
DD_API_KEY=
